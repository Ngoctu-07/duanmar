# Sanity (shared between Next.js frontend and Sanity Studio)
NEXT_PUBLIC_SANITY_PROJECT_ID=your-project-id
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_STUDIO_URL=http://localhost:3333
SANITY_API_READ_TOKEN=your-viewer-token
# Secret shared with the Sanity "publish → /api/revalidate" webhook (openssl rand -hex 32)
SANITY_REVALIDATE_SECRET=

# Transactional email (plan 260929-2229) — dry-run (log-only) when unset.
# EMAIL_FROM must use a domain verified in Resend (SPF + DKIM); SENDER_EMAIL is an alias.
RESEND_API_KEY=
EMAIL_FROM=DuanMar Travel <noreply@your-verified-domain>
# Optional alias for EMAIL_FROM (bare address or "Name <address>")
SENDER_EMAIL=
# Delay before dispatching the booking-confirmation email (default 120000 = 2 min)
BOOKING_EMAIL_DELAY_MS=120000

# Web3 crypto payment rail (MetaMask) — rail hidden when the wallet address is unset.
# Business EVM deposit wallet + accepted stablecoin contract (Polygon USDT default).
NEXT_PUBLIC_CRYPTO_WALLET_ADDRESS=
NEXT_PUBLIC_CRYPTO_CHAIN_ID=137
NEXT_PUBLIC_CRYPTO_TOKEN_ADDRESS=0xc2132D05D31c914a87C6611C10748AEb04B58e8F
NEXT_PUBLIC_CRYPTO_TOKEN_SYMBOL=USDT
NEXT_PUBLIC_CRYPTO_TOKEN_DECIMALS=6
# VND→USD rate for pricing VND bookings in a USD stablecoin (e.g. 25000).
NEXT_PUBLIC_CRYPTO_VND_PER_USD=

# Optional looping ambience for the homepage hero background (mp4/webm URL).
# Unset → the CSS fog/grain backdrop is used.
NEXT_PUBLIC_HERO_AMBIENT_VIDEO=

# AI tour assistant (plan 260929-2335) — keyless dry-run (grounded canned reply) when unset
GEMINI_API_KEY=
# Optional model override (default: gemini-3.5-flash-lite)
ASSISTANT_MODEL=

# Auth.js (NextAuth v5) — email/password sessions. Generate with: openssl rand -hex 32
# Unset → a fixed development key is used (fine for local dev, never for production).
AUTH_SECRET=

# SQLite file holding users, vouchers, account bookings, likes and reviews.
# Defaults to data/article-likes.db. Point this at a persistent volume in
# production so profiles/bookings survive restarts and redeploys.
VN_INTERACTIONS_DB_PATH=

# Sanity Studio (Vite exposes only SANITY_STUDIO_* prefixed vars)
SANITY_STUDIO_PROJECT_ID=your-project-id
SANITY_STUDIO_DATASET=production
